# NEURAX .gitignore

# Build artifacts
build/
bin/
*/build/
*/bin/
software/lib/lib/
*.o
*.a
*.so
*.so.*

# Ensure source files are not ignored
!software/lib/src/
!software/lib/src/**
!software/lib/include/
!software/lib/include/**

# Debug files
*.gdb_history
*.gdb
core.*
vgcore.*

# Test artifacts
tests/build/
tests/bin/
*.gcov
*.gcda
*.gcno

# Demo artifacts
demo/build/
demo/bin/

# Documentation artifacts
docs/*.pdf
docs/*.html
docs/latex/
docs/html/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
*.tmp

# Log files
*.log
*.out

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

build/
.venv/
*.bin
*.npy
manifest.jsonž
*.npz
.vscode/

# toolchain files
toolchain/*