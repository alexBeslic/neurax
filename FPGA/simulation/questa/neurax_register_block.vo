output 	[12:0] neurax_tensor_size_o;
output 	[15:0] neurax_alpha_o;
output 	[2:0] neurax_batch_size_o;
output 	neurax_input_valid_o;
input 	neurax_input_ready_i;
output 	neurax_weight_valid_o;
input 	neurax_weight_ready_i;
output 	neurax_bias_valid_o;
input 	neurax_bias_ready_i;
input 	neurax_output_valid_i;
