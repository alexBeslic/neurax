USE IEEE.STD_LOGIC_ARITH.ALL;

ENTITY 	FPGA_accelerator IS
    PORT (
	clk : IN std_logic;
	rst : IN std_logic;
	enable : IN std_logic;
	operation_select : IN std_logic_vector(1 DOWNTO 0);
	start_operation : IN std_logic;
	conv_kernel_size : IN STD.STANDARD.integer range 1 TO 5;
	conv_stride : IN STD.STANDARD.integer range 1 TO 4;
	conv_padding : IN STD.STANDARD.integer range 0 TO 2;
	conv_input_channels : IN STD.STANDARD.integer range 1 TO 4;
	conv_output_channels : IN STD.STANDARD.integer range 1 TO 4;
	pool_size : IN STD.STANDARD.integer range 1 TO 8;
	pool_stride : IN STD.STANDARD.integer range 1 TO 8;
	\pool_type.MAX_POOL\ : IN std_logic;
	\pool_type.AVERAGE_POOL\ : IN std_logic;
	\pool_type.MIN_POOL\ : IN std_logic;
	\pool_type.SUM_POOL\ : IN std_logic;
	pool_channels : IN STD.STANDARD.integer range 1 TO 4;
	\activation_type.RELU\ : IN std_logic;
	\activation_type.SIGMOID\ : IN std_logic;
	\activation_type.TANH\ : IN std_logic;
	\activation_type.LINEAR\ : IN std_logic;
	\activation_type.LEAKY_RELU\ : IN std_logic;
	\activation_type.ELU\ : IN std_logic;
	tensor_size : IN STD.STANDARD.integer range 1 TO 4096;
	alpha : IN std_logic_vector(15 DOWNTO 0);
	batch_size : IN STD.STANDARD.integer range 1 TO 4;
	input_valid : IN std_logic;
	input_data : IN std_logic_vector(63 DOWNTO 0);
	input_ready : OUT std_logic;
	weight_valid : IN std_logic;
	weight_data : IN std_logic_vector(15 DOWNTO 0);
	weight_ready : OUT std_logic;
	bias_valid : IN std_logic;
	bias_data : IN std_logic_vector(15 DOWNTO 0);
	bias_ready : OUT std_logic;
	output_valid : OUT std_logic;
	output_data : OUT std_logic_vector(63 DOWNTO 0);
	output_ready : IN std_logic;
	operation_done : OUT std_logic;
	operation_busy : OUT std_logic;
	current_operation : OUT std_logic_vector(1 DOWNTO 0);
	debug_cycles : OUT std_logic_vector(31 DOWNTO 0);
	debug_status : OUT std_logic_vector(7 DOWNTO 0)
	);
END FPGA_accelerator;

